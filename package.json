{
  "name": "slack-to-html",
  "version": "2.0.0",
  "description": "Render Slack message markdown as HTML. Zero dependencies, TypeScript types included.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/umd/index.umd.js",
  "jsdelivr": "./dist/umd/index.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./emoji": {
      "import": {
        "types": "./dist/emoji.d.mts",
        "default": "./dist/emoji.mjs"
      },
      "require": {
        "types": "./dist/emoji.d.cts",
        "default": "./dist/emoji.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "generate-emoji": "tsx scripts/generateEmoji.ts",
    "fuzz:capture": "tsx scripts/differentialFuzz.ts capture",
    "fuzz:compare": "tsx scripts/differentialFuzz.ts compare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "publint && attw --pack . --profile node16",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hectorbenitez/slack-to-html.git"
  },
  "keywords": [
    "slack",
    "markdown",
    "html",
    "mrkdwn",
    "emoji",
    "renderer",
    "typescript"
  ],
  "author": "Hector Benitez",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hectorbenitez/slack-to-html/issues"
  },
  "homepage": "https://github.com/hectorbenitez/slack-to-html#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "emoji-datasource": "^16.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
